@model IEnumerable<DatabaseFirst.Models.Customer>

@{
    ViewData["Title"] = "Customers";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Customers</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f8f9fa; }

        .page-header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.8rem;
            color: white;
            flex-shrink: 0;
        }

        .table > thead > tr > th {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6c757d;
            border-bottom: 2px solid #dee2e6;
        }

        .table > tbody > tr {
            transition: background-color 0.15s;
        }

        .table > tbody > tr:hover {
            background-color: #f1f3f9;
        }

        .action-btn {
            padding: 0.25rem 0.55rem;
            font-size: 0.8rem;
        }

        .badge-orders {
            background-color: #e9ecef;
            color: #495057;
            font-weight: 500;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: #adb5bd;
        }
    </style>
</head>
<body>

    <div class="page-header">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h3 mb-1 fw-semibold">
                        <i class="bi bi-people-fill me-2 opacity-75"></i>Customers
                    </h1>
                    <p class="mb-0 opacity-50 small">@Model.Count() customer@(Model.Count() == 1 ? "" : "s") total</p>
                </div>
                <a asp-action="Create" class="btn btn-light btn-sm fw-semibold px-3">
                    <i class="bi bi-plus-lg me-1"></i>Add Customer
                </a>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width:40%">Customer</th>
                                    <th>Phone</th>
                                    <th>Member Since</th>
                                    <th>Orders</th>
                                    <th class="pe-4 text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var colors = new[] { "#4361ee", "#3a0ca3", "#7209b7", "#f72585", "#4cc9f0", "#06d6a0" };
                                    int i = 0;
                                }
                                @foreach (var customer in Model)
                                {
                                    var color = colors[i++ % colors.Length];
                                    var initials = $"{customer.FirstName?[0]}{customer.LastName?[0]}".ToUpper();
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="avatar" style="background-color:@color">@initials</div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@customer.FirstName @customer.LastName</div>
                                                    <div class="small text-muted">@customer.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted">@(customer.Phone ?? "—")</td>
                                        <td class="text-muted">@customer.CreatedAt.ToString("MMM d, yyyy")</td>
                                        <td>
                                            <span class="badge badge-orders rounded-pill px-2">
                                                @customer.Orders.Count order@(customer.Orders.Count == 1 ? "" : "s")
                                            </span>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <a asp-action="Details" asp-route-customerid="@customer.CustomerId"
                                               class="btn btn-outline-secondary action-btn me-1" title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-customerid="@customer.CustomerId"
                                               class="btn btn-outline-primary action-btn me-1" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-customerid="@customer.CustomerId"
                                               class="btn btn-outline-danger action-btn" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-people display-4 d-block mb-3"></i>
                        <p class="mb-3">No customers yet.</p>
                        <a asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Add your first customer
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
